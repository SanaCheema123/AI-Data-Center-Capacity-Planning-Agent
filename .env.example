POSTGRES_PASSWORD=your_value_here
APP_NAME=AI Data Center Capacity Planning Agent
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=sqlite:///./capacity_real.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your_value_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=your_value_here
REFRESH_TOKEN_EXPIRE_DAYS=your_value_here

# First-run authentication for local development only.
BOOTSTRAP_FIRST_USER_AS_ADMIN=true
ALLOW_PUBLIC_REGISTRATION=true

# Real-data collector cadence (Celery beat)
COLLECTOR_SYNC_MINUTES=15

# AI is optional. Keep local for a no-key installation.
AI_PROVIDER=local
GEMINI_API_KEY=your_value_here
GROQ_API_KEY=your_value_here
FORECAST_DEFAULT_MODEL=prophet
REPORT_OUTPUT_DIR=./artifacts/reports
